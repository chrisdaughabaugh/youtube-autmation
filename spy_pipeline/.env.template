# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Groq API (free tier) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# TTS: edge-tts is free, no key required
# Voice options (deep/dramatic): en-US-GuyNeural, en-US-ChristopherNeural, en-GB-RyanNeural
TTS_VOICE=en-US-ChristopherNeural

# Video config
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
TARGET_DURATION_MIN=60
TARGET_DURATION_MAX=90

# Caption style
CAPTION_FONT_SIZE=72
CAPTION_COLOR=#FFFFFF

# Batch
BATCH_SIZE=5

# Music: path to your royalty-free music folder (relative to spy_pipeline/)
MUSIC_PATH=assets/music

# Groq model (free tier options: llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile
